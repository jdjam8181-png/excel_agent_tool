{
  "rules": [
    {
      "mode": "db_to_bigdata",
      "source_db": "oceanbase",
      "target_db": "hbase",

      "source_components": {
        "ds": {
          "bin": [
            "mdsd",
            "mdsc",
            "nfm_sender"
          ]
        }
      },

      "target_components": {
        "dt": {
          "bin": [
            "jddmDSGKafkaEngine.jar"
          ],
          "module": [
            "jddm.engine.module.databaseOperation.jar"
          ]
        },
        "dy": {
          "bin": [
            "nfmd",
            "yloader",
            "mloader"
          ]
        }
      }
    },


    {
      "mode": "db_to_bigdata",
      "source_db": "oracle",
      "target_db": "kafka",

      "source_components": {
        "ds": {
          "bin": [
            "vagentd",
            "aoxd",
            "oxad"
          ]
        }
      },

      "target_components": {
        "dt": {
          "bin": [
            "jddmDSGKafkaEngine.jar"
          ],
          "module": [
            "jddm.engine.module.databaseOperation.jar"
          ]
        },
        "dy": {
          "bin": [
            "xagentd",
            "yloader",
            "mloader"
          ]
        }
      }
    },


